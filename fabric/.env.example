# AgentTrust Fabric Infrastructure Environment Variables
# Copy this file to .env before starting docker-compose-fabric.yaml in production

# CouchDB Credentials
COUCHDB_USER=admin
COUCHDB_PASSWORD=replace_with_secure_production_password_couchdb

# Fabric CA Bootstrap Admin Credentials
FABRIC_CA_ADMIN_USER=admin
FABRIC_CA_ADMIN_PASSWORD=replace_with_secure_production_password_fabric_ca

# Fabric Gateway Token (Min 32 characters)
FABRIC_GATEWAY_TOKEN=agenttrust_fabric_gateway_secure_token_32chars_min_secret

# Raft Consensus Ports (3-node Quorum)
ORDERER_PORT_NODE1=7050
ORDERER_PORT_NODE2=8050
ORDERER_PORT_NODE3=9050
