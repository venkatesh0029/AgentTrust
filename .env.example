# ==============================================================================
# AgentTrust Environment Configuration Template (.env.example)
# Copy this file to .env and customize for your target deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Deployment Profile & Mode
# ------------------------------------------------------------------------------
# Options: development | demo | production
# WARNING: Production enforces strict fail-closed security invariants.
AGENTTRUST_ENV=development

# Operational Security Mode:
# - MODE_A_DIRECT_API: Direct downstream API execution (No defense / Baseline)
# - MODE_B_AUTH_RBAC: Basic authentication & role-based access control
# - MODE_C_AGENTTRUST_NO_FABRIC: Full 13-stage gateway with local hash-chain audit
# - MODE_D_AGENTTRUST_FABRIC: Enterprise defense with Hyperledger Fabric consensus
AGENTTRUST_MODE=MODE_C_AGENTTRUST_NO_FABRIC

# Allow dynamic runtime mode switching via /mode API (Set to false in production)
AGENTTRUST_ALLOW_MODE_CHANGE=true

# Demo Mode Flag (Set to true only for local UI demonstrations; ignored in production)
AGENTTRUST_DEMO_MODE=false

# ------------------------------------------------------------------------------
# 2. Cryptographic Secrets & Authentication
# ------------------------------------------------------------------------------
# Internal Action Gateway shared secret (Must be >= 32 characters in production)
GATEWAY_SECRET=development-gateway-secret-token-32-chars-long!

# JWT signing secret (Must have Shannon entropy >= 3.0 bits/char and >= 32 chars)
AGENTTRUST_JWT_SECRET=DevelopmentSecretKeyWithHighEntropyAndLength1234567890!

# Administrator Passwords (Production fails closed if default/weak passwords are used)
AGENTTRUST_ADMIN_PASSWORD=AdminTrust#2026!Secured
AGENTTRUST_POLICY_ADMIN_PASSWORD=PolicyTrust#2026!Secured
AGENTTRUST_FINANCE_APPROVER_PASSWORD=FinanceTrust#2026!Secured
AGENTTRUST_AUDITOR_PASSWORD=AuditorTrust#2026!Secured

# ------------------------------------------------------------------------------
# 3. Network & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: Explicit HTTPS origins only (e.g. https://agenttrust.corp.internal)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Binding
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# 4. Storage & Persistence
# ------------------------------------------------------------------------------
# Path to SQLite state machine store
AGENTTRUST_DB_PATH=agenttrust_persistent.db

# ------------------------------------------------------------------------------
# 5. Hyperledger Fabric & Ledger Configuration
# ------------------------------------------------------------------------------
# Fabric Gateway Mode:
# - simulator: In-memory/SQLite simulated ledger (For development, demo & CI)
# - live: Real Hyperledger Fabric network via REST bridge (Mandatory for Production Mode D)
FABRIC_GATEWAY_MODE=simulator

# URL for the live Fabric Gateway REST Bridge (required when FABRIC_GATEWAY_MODE=live)
FABRIC_GATEWAY_URL=http://localhost:8090

# Shared bearer authentication token for Fabric Gateway Bridge
FABRIC_GATEWAY_TOKEN=
